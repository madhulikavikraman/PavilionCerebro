# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Heavy grader model id. Default follows the Claude API reference; set claude-sonnet-5 to cut cost.
GRADER_MODEL=claude-opus-5
# Cloud gate fallback model id (used when --gate claude)
GATE_CLOUD_MODEL=claude-haiku-4-5
# Local models served by Ollama. Use the -instruct tags: the plain tags run with thinking on and can
# exhaust their output budget before emitting JSON.
GATE_LOCAL_MODEL=qwen3-vl:4b-instruct
GRADER_LOCAL_MODEL=qwen3-vl:8b-instruct
OLLAMA_URL=http://localhost:11434
